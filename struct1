#include <stdio.h>

struct Student
{
    char name[30];
    int rollNo;
    char address[50];
};

int main()
{
    struct Student s1;

    printf("Enter Student Name: ");
    scanf("%s", s1.name);

    printf("Enter Roll Number: ");
    scanf("%d", &s1.rollNo);

    printf("Enter Student Address: ");
    scanf("%s", s1.address);

    printf("\nStudent Details\n");
    printf("Name     : %s\n", s1.name);
    printf("Roll No  : %d\n", s1.rollNo);
    printf("Address  : %s\n", s1.address);

    return 0;
}
